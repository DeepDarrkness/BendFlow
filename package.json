{
  "name": "bendflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:bend": "node scripts/setup-bend.ts",
    "setup:clang": "node scripts/setup-clang.ts",
    "build:native": "node scripts/build-native.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:native && node --test --test-concurrency=1 --test-timeout=20000 --test-reporter=spec --test-reporter=./scripts/conformance-reporter.ts --test-reporter-destination=stdout --test-reporter-destination=build/phase2-results.json tests/*.test.ts tests/phase2/*.test.ts",
    "example": "node examples/echo.ts",
    "example:session": "node examples/session.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "bun": "1.3.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/server": "1.16.2",
    "zod": "4.6.7"
  }
}
