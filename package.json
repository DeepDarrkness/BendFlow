{
  "name": "bendflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:bend": "node scripts/setup/bend.ts",
    "setup:clang": "node scripts/setup/clang.ts",
    "setup:cuda": "node scripts/setup/cuda.ts",
    "setup:lean": "node scripts/setup/lean.ts",
    "build:native": "node scripts/build/native.ts",
    "build:services": "node scripts/build/services.ts",
    "build:cuda": "node scripts/build/cuda.ts",
    "check:compiler": "node scripts/build/compiler-check.ts",
    "conformance:cuda": "node scripts/conformance/gpu.ts required",
    "conformance:cuda:probe": "node scripts/conformance/gpu.ts probe",
    "conformance:cuda:fallback": "node scripts/conformance/gpu.ts fallback",
    "conformance:cuda:package": "node scripts/conformance/gpu.ts package",
    "conformance:hardware": "node scripts/conformance/hardware.ts",
    "typecheck": "node scripts/test/build-services.ts && tsc --noEmit",
    "test:unit": "node scripts/test/run.ts unit",
    "test:integration": "node scripts/test/run.ts integration",
    "test:compiler": "node scripts/test/run.ts compiler",
    "test:types": "node scripts/test/run.ts types",
    "test": "node scripts/test/run.ts full",
    "conformance:portable": "node scripts/conformance/completion.ts --mode portable",
    "conformance:full": "node scripts/conformance/completion.ts --mode full",
    "example": "node examples/echo.ts",
    "example:session": "node examples/session.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "bun": "1.3.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/server": "1.16.2",
    "zod": "4.6.7"
  }
}
