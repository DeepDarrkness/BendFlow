{
  "name": "bendflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "setup:bend": "node scripts/setup-bend.ts",
    "setup:clang": "node scripts/setup-clang.ts",
    "build:native": "node scripts/build-native.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:native && node --test --test-concurrency=1 --test-timeout=15000 tests/*.test.ts",
    "example": "node examples/echo.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "bun": "1.3.3",
    "typescript": "5.9.3"
  }
}
