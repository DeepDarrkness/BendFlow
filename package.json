    "example": "node examples/echo.ts",
    "example:session": "node examples/session.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "bun": "1.3.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/server": "1.16.2",
    "zod": "4.6.7"
