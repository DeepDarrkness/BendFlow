{
  "name": "bendflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:bend": "node scripts/setup/bend.ts",
    "setup:clang": "node scripts/setup/clang.ts",
    "build:native": "node scripts/build/native.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/test/run.ts unit",
    "test:integration": "node scripts/test/run.ts integration",
    "test:compiler": "node scripts/test/run.ts compiler",
    "test:types": "node scripts/test/run.ts types",
